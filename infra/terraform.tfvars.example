# Copy to terraform.tfvars and edit if you want to override defaults.
# terraform.tfvars is gitignored. All values below are OPTIONAL — the defaults in
# variables.tf reproduce the original stack.

# region            = "ap-south-1"
# project_name      = "citementor"
# lambda_memory_mb  = 3008
# lambda_timeout_s  = 120
# log_retention_days = 14
# image_tag         = "latest"

# NOTE: the OpenAI API key is NOT set here. Export it in your shell before apply:
#   export OPENAI_API_KEY=sk-...        (or: set -a; source ../.env; set +a)
# Terraform reads it from the environment when pushing the secret value, so the
# key never enters terraform.tfvars or the state file.

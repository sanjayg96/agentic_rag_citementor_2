# CiteMentor API — required runtime configuration.
#
# Copy to `.env` for local development (the core code calls load_dotenv()).
# On AWS, OPENAI_API_KEY is injected from Secrets Manager (see Phase 4) — it is
# never baked into the container image.

# Required. Used for OpenAI embeddings (text-embedding-3-small), the router
# (gpt-5-nano), and answer synthesis (gpt-5-mini). The pipeline runs in
# inference_mode=openai (config/retrieval.yaml), so this is the only secret needed.
OPENAI_API_KEY=sk-...

# NOT required in OpenAI mode. HF_TOKEN is only used to download local
# (sentence-transformers / MLX) models, which the slim API container excludes.
# HF_TOKEN=hf_...

# Optional. Overrides the bundled ChromaDB path. On Lambda the app copies the
# read-only bundled DB to /tmp at cold start and sets this (added in Phase 2).
# CHROMA_DIR=storage/chroma_db

# AWS only (Phase 4). Name/ARN of the Secrets Manager secret holding the OpenAI
# key. When set AND OPENAI_API_KEY is unset, the app fetches the key at cold
# start (service/secrets.py). Leave unset locally — use OPENAI_API_KEY above.
# OPENAI_SECRET_NAME=citementor/openai_api_key

# Bedrock inference mode (inference_mode: bedrock in config/retrieval.yaml).
# Needs NO OpenAI key — the whole pipeline runs on AWS Bedrock (Amazon Nova Lite +
# Nova Pro + Titan V2). Credentials come from the standard AWS chain: locally that's
# your `aws configure` profile; on Lambda it's the execution role. To run bedrock
# mode locally just ensure your AWS CLI is configured. Nova + Titan are first-party
# and auto-enable on first invoke — no Bedrock Marketplace subscription needed.

# Optional (Phase 7). LLM tracing via Langfuse — sign up at
# https://cloud.langfuse.com, create a project, and copy the API key pair from
# Project Settings -> API Keys. If any of these are unset, the app runs
# untraced (service/app.py never constructs the callback handler).
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com

# AWS only (Phase 7). Name/ARN of the Secrets Manager secret holding the
# Langfuse key pair as JSON ({"public_key": ..., "secret_key": ...}). When set
# AND the LANGFUSE_* keys above are unset, the app fetches them at cold start
# (service/secrets.py). Leave unset locally — use the LANGFUSE_* vars above.
# LANGFUSE_SECRET_NAME=citementor/langfuse_keys

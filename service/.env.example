# CiteMentor API — required runtime configuration.
#
# Copy to `.env` for local development (the core code calls load_dotenv()).
# On AWS, OPENAI_API_KEY is injected from Secrets Manager (see Phase 4) — it is
# never baked into the container image.

# Required. Used for OpenAI embeddings (text-embedding-3-small), the router
# (gpt-5-nano), and answer synthesis (gpt-5-mini). The pipeline runs in
# inference_mode=openai (config/retrieval.yaml), so this is the only secret needed.
OPENAI_API_KEY=sk-...

# NOT required in OpenAI mode. HF_TOKEN is only used to download local
# (sentence-transformers / MLX) models, which the slim API container excludes.
# HF_TOKEN=hf_...

# Optional. Overrides the bundled ChromaDB path. On Lambda the app copies the
# read-only bundled DB to /tmp at cold start and sets this (added in Phase 2).
# CHROMA_DIR=storage/chroma_db

# AWS only (Phase 4). Name/ARN of the Secrets Manager secret holding the OpenAI
# key. When set AND OPENAI_API_KEY is unset, the app fetches the key at cold
# start (service/secrets.py). Leave unset locally — use OPENAI_API_KEY above.
# OPENAI_SECRET_NAME=citementor/openai_api_key

# Streamlit secrets — Phase 8 (Streamlit UI → deployed AWS Lambda).
#
# Copy this to `.streamlit/secrets.toml` for LOCAL testing of the remote path,
# or paste the [aws] block into the Streamlit Community Cloud app's Secrets
# (app → ⋮ → Settings → Secrets). NEVER commit real credentials — secrets.toml
# is gitignored; only this .example file is tracked.
#
# The presence of this [aws] block is the toggle: when it is set, the Mentor page
# calls the deployed Function URL; when it is absent (e.g. the `master` Streamlit
# deployment), the app runs the pipeline locally exactly as before.
#
# Generate the key pair with: bash infra/streamlit_user.sh

[aws]
access_key_id     = "AKIA........................"
secret_access_key = "........................................"
region            = "ap-south-1"      # optional; defaults to ap-south-1
function_name     = "citementor-api"  # optional; defaults to citementor-api

# Optional: pin an explicit Function URL to SKIP discovery. Leave unset so the app
# auto-discovers the current URL via lambda:GetFunctionUrlConfig (the URL changes
# on every teardown→redeploy, so pinning means editing this after each deploy).
# function_url = "https://xxxxxxxx.lambda-url.ap-south-1.on.aws/"
